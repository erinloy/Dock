<?xml version="1.0" encoding="utf-8"?>

<configuration>
  <!-- ⚠️ FORK-LOCAL (Ziltch). Upstream ships this file with key="api.nuget.org" and NO packageSourceMapping. That
       combination is broken when Dock is consumed as a submodule of a superproject that DOES declare a mapping:
       NuGet de-duplicates package sources BY URL across the config chain and keeps ONE key, so the superproject's
       `*` -> "nuget" mapping and this file's "api.nuget.org" source cannot both survive — whichever key loses takes
       its mapping entry with it, silently, and NO source is considered for Dock's packages (NU1100/NU1101 on every
       Dock project). It is invisible with a warm ~/.nuget/packages and only fires on a cold cache, i.e. in CI.
       Two changes, both required: (1) the key is "nuget.org", the key that survives NuGet's by-URL source de-duplication (it comes from the
         user-level %APPDATA%NuGetNuGet.Config), matching the superproject root and
       src/nuget.config, so the surviving key is the one every mapping names; (2) this file carries its own mapping,
       so it is self-consistent and does not depend on inheriting the superproject's. See the long note in the
       superproject's root nuget.config, which called out this exact file as broken by the same rule. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
